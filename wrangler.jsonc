{
  // Cloudflare Workers static assets. Only needed if you deploy with the CLI
  // (`npm run deploy`); the Pages Git integration reads none of this and just
  // needs build command `npm run build` and output directory `dist`.
  "name": "church-directory",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    // Client-side routing: unknown paths serve index.html rather than 404.
    // This replaces a _redirects file - Workers rejects the usual
    // "/* /index.html 200" rule as an infinite loop, since /index.html
    // matches /* and re-triggers itself.
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
