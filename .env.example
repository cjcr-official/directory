# Copy this file to .env.local and fill in the two values from your Supabase
# project (Project Settings -> API). Set the same two as environment variables
# on Cloudflare - they are read at build time and baked into the bundle.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key is meant to be public: it ships inside the browser bundle. What
# protects the congregation's details is row level security in
# supabase/migrations, which requires a signed-in administrator for every read.
# Never put the service_role key in this file - it bypasses all of that.
